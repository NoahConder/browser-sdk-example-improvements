# SignalWire credentials (Project dashboard -> API). Never commit the filled-in .env file.
SIGNALWIRE_API=SIGNALWIRE-API-TOKEN-GOES-HERE
SIGNALWIRE_PROJECT=SIGNALWIRE-PROJECT-ID-GOES-HERE
SIGNALWIRE_SPACE=your-space.signalwire.com

# SDK build the page loads: "stable" = pinned CDN release, "local" = node_modules/@signalwire/js/dist
SDK_VERSION=stable

# Where the server listens. Keep 127.0.0.1 unless you need LAN access; the devcontainer sets 0.0.0.0.
HOST=127.0.0.1
PORT=8080
