{
  "name": "browser-sdk-v2-example",
  "version": "2.0.0",
  "description": "SignalWire Browser SDK v2 (Relay client) example with a JWT token server, auto-refresh, device/codec/ICE options and an event log for troubleshooting calls",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --test test/",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,md,json}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NoahConder/browser-sdk-example-improvements.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "dependencies": {
    "@signalwire/js": "^1.5.0",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
